# ==========================================
# ⚙️ STARRY BOT CONFIGURATION
# File Path: .env
# ==========================================

# 1. Primary Discord Bot Token (Create one on Discord Developer Portal)
TOKEN=your_primary_bot_token_here

# 2. MongoDB Database Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ManagerBot?retryWrites=true&w=majority

# 3. Optional: Discord Bot Client ID & Owner ID
CLIENT_ID=your_bot_client_id
OWNER_ID=your_discord_user_id

# 4. Optional: Multi-Bot Cluster Worker Tokens (Comma-separated or TOKEN_2, TOKEN_3...)
BOT_TOKENS=secondary_token_1,secondary_token_2
# TOKEN_2=secondary_worker_token_2

# 5. Optional: Web Server & Spotify API
PORT=10000
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
